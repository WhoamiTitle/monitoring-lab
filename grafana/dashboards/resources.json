        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_label_monitoring_demo) (container_memory_working_set_bytes{job=\"cadvisor\",container_label_monitoring_demo=~\"web-1|web-2\"})",
          "legendFormat": "{{container_label_monitoring_demo}}",
          "instant": false,
          "range": true
        }
      ]
    },
